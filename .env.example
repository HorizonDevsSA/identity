# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=ocr_user
DB_PASSWORD=ocr_secure_password
DB_NAME=ocr_db
DB_SSLMODE=disable

# Redis (Task Queue & Caching)
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_BUCKET=documents

# JWT Secret
JWT_SECRET=supersecretjwttokenkey123!

# Port for Go API Gateway
PORT=8080

# Field-Level Encryption (32-byte hex or string)
ENCRYPTION_KEY=super_secret_key_32_bytes_long!!

# ClamAV Antivirus Scanner
CLAMAV_URL=clamav:3310

# Twilio Configuration (Verify & Messaging)
# If left empty, API Gateway runs in Dev Mode (accepts code '000000' and logs SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ZWC Blockchain Integration
ZWC_BINARY_PATH=/Volumes/Untitled/zwc/zwc-chain/zwc-chaind
ZWC_HOME_DIR=/Users/mac/.zwc-chain
ZWC_VERIFIER_KEY_NAME=bob
ZWC_KEYRING_BACKEND=test
ZWC_CHAIN_ID=zwcchain
ZWC_NODE_URL=tcp://localhost:26657
ZWC_MASTER_SALT=zwc_default_secure_salt_2026
