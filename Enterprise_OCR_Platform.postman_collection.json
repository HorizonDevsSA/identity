				{
					"name": "Get Document Prediction (OCR Result)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"",
									"if (pm.response.code === 404 && (jsonData.status === \"pending\" || jsonData.status === \"processing\")) {",
									"    console.log(\"OCR job is still processing... retrying in 3 seconds.\");",
									"    setTimeout(function() {",
									"        postman.setNextRequest(\"Get Document Prediction (OCR Result)\");",
									"    }, 3000);",
									"} else {",
									"    pm.test(\"Status code is 200\", function () {",
									"        pm.response.to.have.status(200);",
									"    });",
									"    ",
									"    pm.test(\"Response contains OCR output and confidence\", function () {",
									"        pm.expect(jsonData.confidence).to.be.a(\"number\");",
									"        pm.expect(jsonData.raw_json).to.be.a(\"string\");",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
