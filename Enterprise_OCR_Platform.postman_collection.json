				{
					"name": "Get Document Details",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains document structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.document).to.be.an(\"object\");",
									"    pm.expect(jsonData.document.id).to.eql(pm.environment.get(\"documentId\"));",
									"    if (jsonData.document.status === \"completed\") {",
									"        pm.expect(jsonData.document.verification_status).to.eql(\"verified\");",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
